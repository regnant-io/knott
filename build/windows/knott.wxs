<?xml version="1.0" encoding="UTF-8"?>
<!--
  Windows installer for KNOTT (WiX Toolset v3).

  Installs the binary, puts it on PATH so `knott` works from any terminal, and
  adds Start Menu and Desktop shortcuts that open KNOTT in its own window. It
  deliberately does not register a Windows service: a workflow engine that
  starts listening the moment it is installed is a surprise, not a convenience —
  `knott serve` is one command when an operator is ready.

  Build:
    candle -arch x64 -dVersion=1.0.0 -dSourceDir=dist\knott_v1.0.0_windows_amd64 build\windows\knott.wxs
    light  -ext WixUIExtension -ext WixUtilExtension -out dist\KNOTT-1.0.0-x64.msi knott.wixobj
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <Product Id="*"
           Name="KNOTT"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="Regnant"
           UpgradeCode="8E2F5C41-9B3A-4D77-9E1C-0A6D5F2B7C34">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="KNOTT — sovereign workflow orchestration"
             Manufacturer="Regnant" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of KNOTT is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="KnottIcon" SourceFile="brand\icons\knott.ico" />
    <Property Id="ARPPRODUCTICON" Value="KnottIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/regnant/knott" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="KNOTT">
          <Directory Id="AIENGINEFOLDER" Name="ai-decision-engine" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppMenuFolder" Name="KNOTT" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="KnottExe" Guid="*">
        <File Id="knott.exe" Name="knott.exe" Source="$(var.SourceDir)\knott.exe" KeyPath="yes">
          <!-- Both shortcuts open the app window; the CLI stays available on PATH. -->
          <Shortcut Id="StartMenuShortcut"
                    Directory="AppMenuFolder"
                    Name="KNOTT"
                    Description="Design, run and audit workflows on your own infrastructure"
                    Arguments="desktop"
                    Icon="KnottIcon"
                    Advertise="yes" />
          <Shortcut Id="DesktopShortcut"
                    Directory="DesktopFolder"
                    Name="KNOTT"
                    Arguments="desktop"
                    Icon="KnottIcon"
                    Advertise="yes" />
        </File>
        <Environment Id="KnottPath"
                     Name="PATH"
                     Value="[INSTALLFOLDER]"
                     Permanent="no"
                     Part="last"
                     Action="set"
                     System="yes" />
      </Component>

      <Component Id="KnottDocs" Guid="*">
        <File Id="LICENSE.txt" Name="LICENSE.txt" Source="LICENSE" KeyPath="yes" />
        <File Id="NOTICE.txt" Name="NOTICE.txt" Source="NOTICE" />
        <File Id="README.md" Name="README.md" Source="README.md" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="AIENGINEFOLDER">
      <!-- Optional: KNOTT falls back to rule-based decisions when Python is absent. -->
      <Component Id="AIEngine" Guid="*">
        <File Id="ai_main.py" Name="main.py"
              Source="services\ai-decision-engine\main.py" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="AppMenuFolder">
      <Component Id="AppMenuCleanup" Guid="*">
        <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Regnant\KNOTT"
                       Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Complete" Title="KNOTT" Level="1" Display="expand"
             Description="The KNOTT server, console and command line.">
      <ComponentRef Id="KnottExe" />
      <ComponentRef Id="KnottDocs" />
      <ComponentRef Id="AIEngine" />
      <ComponentRef Id="AppMenuCleanup" />
    </Feature>

    <UIRef Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="build\windows\license.rtf" />
  </Product>
</Wix>
