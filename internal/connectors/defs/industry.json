    ],
    "http": {
      "base_url": "{cred:FHIR_BASE_URL}",
      "auth": {"type": "bearer", "credential": "FHIR_ACCESS_TOKEN"},
      "headers": {"Accept": "application/fhir+json", "Content-Type": "application/fhir+json"},
      "test": {"id": "test", "label": "Capability statement", "method": "GET", "path": "/metadata", "fields": []}
    },
    "actions": [
      {"id": "read", "label": "Read resource", "method": "GET", "path": "/{resource_type}/{id}",
       "fields": [
         {"name": "resource_type", "label": "Resource type", "required": true, "placeholder": "Patient"},
         {"name": "id", "label": "Resource ID", "required": true}
       ]},
      {"id": "search", "label": "Search", "method": "GET", "path": "/{resource_type}?{search*}", "items_path": "entry",
       "fields": [
         {"name": "resource_type", "label": "Resource type", "required": true, "placeholder": "Observation"},
         {"name": "search", "label": "Search parameters", "placeholder": "patient=123&category=vital-signs"}
       ]},
      {"id": "create", "label": "Create resource", "method": "POST", "path": "/{resource_type}", "body": "{resource}",
       "fields": [
         {"name": "resource_type", "label": "Resource type", "required": true},
         {"name": "resource", "label": "Resource (JSON)", "type": "json", "required": true}
       ]}
    ]
  },
