  {
    "slug": "webflow", "name": "Webflow", "category": "Productivity", "color": "#146EF5", "icon": "globe",
    "description": "List and create CMS items in Webflow",
    "docs_url": "https://developers.webflow.com/data/reference",
    "credentials": [{"name": "WEBFLOW_TOKEN", "label": "Site API token", "secret": true}],
    "http": {
      "base_url": "https://api.webflow.com/v2",
      "auth": {"type": "bearer", "credential": "WEBFLOW_TOKEN"},
      "test": {"id": "test", "label": "Token", "method": "GET", "path": "/token/authorized_by", "fields": []}
    },
