[
  {
    "slug": "todoist", "name": "Todoist", "category": "Productivity", "color": "#E44332", "icon": "check-square",
    "description": "Create, list and complete tasks in Todoist",
    "docs_url": "https://developer.todoist.com/api/v1/",
    "credentials": [{"name": "TODOIST_API_TOKEN", "label": "API token", "secret": true, "help": "Settings → Integrations → Developer."}],
    "http": {
      "base_url": "https://api.todoist.com/api/v1",
      "auth": {"type": "bearer", "credential": "TODOIST_API_TOKEN"},
      "test": {"id": "test", "label": "Projects", "method": "GET", "path": "/projects", "fields": []}
    },
    "actions": [
      {"id": "create_task", "label": "Create task", "method": "POST", "path": "/tasks",
       "body": {"content": "{content}", "description": "{description}", "due_string": "{due}", "priority": "{priority}", "project_id": "{project_id}", "labels": "{labels}"},
       "fields": [
         {"name": "content", "label": "Task", "required": true},
         {"name": "description", "label": "Description", "type": "textarea"},
         {"name": "due", "label": "Due", "placeholder": "tomorrow at 9am"},
         {"name": "priority", "label": "Priority (1–4)", "type": "number"},
         {"name": "project_id", "label": "Project ID"},
         {"name": "labels", "label": "Labels (JSON array)", "type": "json"}
       ]},
      {"id": "list_tasks", "label": "List tasks", "method": "GET", "path": "/tasks", "query": {"project_id": "{project_id}"}, "items_path": "results",
       "fields": [{"name": "project_id", "label": "Project ID"}]},
      {"id": "close_task", "label": "Complete task", "method": "POST", "path": "/tasks/{task_id}/close", "body_type": "none",
       "fields": [{"name": "task_id", "label": "Task ID", "required": true}]}
    ]
  },
  {
    "slug": "smartsheet", "name": "Smartsheet", "category": "Productivity", "color": "#0073EC", "icon": "table",
    "description": "Read sheets and add rows in Smartsheet",
    "docs_url": "https://smartsheet.redoc.ly/",
    "credentials": [{"name": "SMARTSHEET_TOKEN", "label": "API access token", "secret": true, "help": "Account → Apps & Integrations → API Access."}],
    "http": {
      "base_url": "https://api.smartsheet.com/2.0",
      "auth": {"type": "bearer", "credential": "SMARTSHEET_TOKEN"},
      "test": {"id": "test", "label": "Current user", "method": "GET", "path": "/users/me", "fields": []}
    },
    "actions": [
      {"id": "add_rows", "label": "Add rows", "method": "POST", "path": "/sheets/{sheet_id}/rows", "body": "{rows}",
       "fields": [
         {"name": "sheet_id", "label": "Sheet ID", "required": true},
         {"name": "rows", "label": "Rows (JSON array)", "type": "json", "required": true, "placeholder": "[{ \"toBottom\": true, \"cells\": [{ \"columnId\": 123, \"value\": \"{{ input.name }}\" }] }]"}
       ]},
      {"id": "get_sheet", "label": "Get sheet", "method": "GET", "path": "/sheets/{sheet_id}",
       "fields": [{"name": "sheet_id", "label": "Sheet ID", "required": true}]}
    ]
  },
  {
    "slug": "wrike", "name": "Wrike", "category": "Productivity", "color": "#08CF65", "icon": "check-square",
    "description": "Create tasks in Wrike folders and projects",
    "docs_url": "https://developers.wrike.com/api/v4/",
    "credentials": [{"name": "WRIKE_TOKEN", "label": "Permanent access token", "secret": true, "help": "Apps & Integrations → API."}],
    "http": {
      "base_url": "https://www.wrike.com/api/v4",
      "auth": {"type": "bearer", "credential": "WRIKE_TOKEN"},
      "test": {"id": "test", "label": "Me", "method": "GET", "path": "/contacts", "query": {"me": "true"}, "fields": []}
    },
    "actions": [
      {"id": "create_task", "label": "Create task", "method": "POST", "path": "/folders/{folder_id}/tasks", "body_type": "form",
       "body": {"title": "{title}", "description": "{description}", "importance": "{importance}"},
       "fields": [
         {"name": "folder_id", "label": "Folder or project ID", "required": true},
         {"name": "title", "label": "Title", "required": true},
         {"name": "description", "label": "Description", "type": "textarea"},
         {"name": "importance", "label": "Importance", "type": "select", "options": ["High", "Normal", "Low"]}
       ]}
    ]
  },
  {
    "slug": "shortcut", "name": "Shortcut", "category": "Productivity", "color": "#58B1E4", "icon": "check-square",
    "description": "Create stories in Shortcut (formerly Clubhouse)",
    "docs_url": "https://developer.shortcut.com/api/rest/v3",
    "credentials": [{"name": "SHORTCUT_TOKEN", "label": "API token", "secret": true}],
