  {
    "slug": "toggl", "name": "Toggl Track", "category": "Productivity", "color": "#E57CD8", "icon": "clock",
    "description": "Log and read time entries in Toggl Track",
    "docs_url": "https://engineering.toggl.com/docs/",
    "credentials": [{"name": "TOGGL_API_TOKEN", "label": "API token", "secret": true, "help": "Profile settings → API Token."}],
    "http": {
      "base_url": "https://api.track.toggl.com/api/v9",
      "auth": {"type": "basic", "credential": "TOGGL_API_TOKEN", "password_value": "api_token"},
      "test": {"id": "test", "label": "Me", "method": "GET", "path": "/me", "fields": []}
    },
    "actions": [
      {"id": "list_time_entries", "label": "List my time entries", "method": "GET", "path": "/me/time_entries", "query": {"start_date": "{start_date}", "end_date": "{end_date}"},
       "fields": [
         {"name": "start_date", "label": "Start (YYYY-MM-DD)"},
         {"name": "end_date", "label": "End (YYYY-MM-DD)"}
       ]},
      {"id": "create_time_entry", "label": "Create time entry", "method": "POST", "path": "/workspaces/{workspace_id}/time_entries",
       "body": {"workspace_id": "{workspace_id}", "description": "{description}", "start": "{start}", "duration": "{duration}", "project_id": "{project_id}", "created_with": "KNOTT"},
       "fields": [
         {"name": "workspace_id", "label": "Workspace ID", "type": "number", "required": true},
         {"name": "start", "label": "Start (RFC 3339)", "required": true},
         {"name": "duration", "label": "Duration (seconds)", "type": "number", "required": true},
         {"name": "description", "label": "Description"},
         {"name": "project_id", "label": "Project ID", "type": "number"}
       ]}
    ]
  },
