      "auth": {"type": "header", "header": "Shortcut-Token", "credential": "SHORTCUT_TOKEN"},
      "test": {"id": "test", "label": "Member", "method": "GET", "path": "/member", "fields": []}
    },
    "actions": [
      {"id": "create_story", "label": "Create story", "method": "POST", "path": "/stories",
       "body": {"name": "{name}", "description": "{description}", "story_type": "{story_type}", "workflow_state_id": "{workflow_state_id}", "group_id": "{group_id}"},
       "fields": [
         {"name": "name", "label": "Name", "required": true},
         {"name": "description", "label": "Description", "type": "textarea"},
         {"name": "story_type", "label": "Type", "type": "select", "options": ["feature", "bug", "chore"]},
         {"name": "workflow_state_id", "label": "Workflow state ID", "type": "number", "required": true},
         {"name": "group_id", "label": "Team (group) ID"}
       ]}
    ]
  },
  {
    "slug": "basecamp", "name": "Basecamp", "category": "Productivity", "color": "#1D2D35", "icon": "check-square",
    "description": "Add to-dos to Basecamp projects",
    "docs_url": "https://github.com/basecamp/bc3-api",
    "credentials": [
      {"name": "BASECAMP_ACCOUNT_ID", "label": "Account ID", "help": "The number after 3.basecamp.com/ in your URL."},
      {"name": "BASECAMP_ACCESS_TOKEN", "label": "OAuth access token", "secret": true}
    ],
    "http": {
      "base_url": "https://3.basecampapi.com/{cred:BASECAMP_ACCOUNT_ID}",
      "auth": {"type": "bearer", "credential": "BASECAMP_ACCESS_TOKEN"},
      "headers": {"User-Agent": "KNOTT (https://github.com/regnant-io/knott)"},
      "test": {"id": "test", "label": "Projects", "method": "GET", "path": "/projects.json", "fields": []}
    },
    "actions": [
      {"id": "create_todo", "label": "Create to-do", "method": "POST", "path": "/buckets/{project_id}/todolists/{todolist_id}/todos.json",
       "body": {"content": "{content}", "description": "{description}", "due_on": "{due_on}"},
       "fields": [
         {"name": "project_id", "label": "Project ID", "required": true},
         {"name": "todolist_id", "label": "To-do list ID", "required": true},
         {"name": "content", "label": "To-do", "required": true},
         {"name": "description", "label": "Notes", "type": "textarea"},
         {"name": "due_on", "label": "Due (YYYY-MM-DD)"}
       ]}
    ]
  },
  {
    "slug": "confluence", "name": "Confluence", "category": "Productivity", "color": "#1868DB", "icon": "file-text",
    "description": "Publish pages to Confluence Cloud",
    "docs_url": "https://developer.atlassian.com/cloud/confluence/rest/v2/",
    "credentials": [
      {"name": "CONFLUENCE_URL", "label": "Site URL", "placeholder": "https://acme.atlassian.net"},
      {"name": "CONFLUENCE_EMAIL", "label": "Account email"},
      {"name": "CONFLUENCE_API_TOKEN", "label": "API token", "secret": true, "help": "id.atlassian.com → Security → API tokens."}
    ],
    "http": {
      "base_url": "{cred:CONFLUENCE_URL}/wiki/api/v2",
      "auth": {"type": "basic", "credential": "CONFLUENCE_EMAIL", "password": "CONFLUENCE_API_TOKEN"},
      "test": {"id": "test", "label": "Spaces", "method": "GET", "path": "/spaces", "query": {"limit": "1"}, "fields": []}
    },
    "actions": [
      {"id": "create_page", "label": "Create page", "method": "POST", "path": "/pages",
       "body": {"spaceId": "{space_id}", "status": "current", "title": "{title}", "parentId": "{parent_id}", "body": {"representation": "storage", "value": "{body}"}},
       "fields": [
         {"name": "space_id", "label": "Space ID", "required": true},
         {"name": "title", "label": "Title", "required": true},
         {"name": "body", "label": "Body (storage format / HTML)", "type": "textarea", "required": true},
         {"name": "parent_id", "label": "Parent page ID"}
       ]}
    ]
  },
  {
