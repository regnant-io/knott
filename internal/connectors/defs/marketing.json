[
  {
    "slug": "brevo", "name": "Brevo", "category": "Marketing", "color": "#0B996E", "icon": "mail",
    "description": "Manage contacts and send transactional email with Brevo (Sendinblue)",
    "docs_url": "https://developers.brevo.com/reference",
    "credentials": [{"name": "BREVO_API_KEY", "label": "API key", "secret": true, "help": "Brevo → SMTP & API → API keys."}],
    "http": {
      "base_url": "https://api.brevo.com/v3",
      "auth": {"type": "header", "header": "api-key", "credential": "BREVO_API_KEY"},
      "test": {"id": "test", "label": "Account", "method": "GET", "path": "/account", "fields": []}
    },
    "actions": [
      {"id": "create_contact", "label": "Create or update contact", "method": "POST", "path": "/contacts",
       "body": {"email": "{email}", "attributes": "{attributes}", "listIds": "{list_ids}", "updateEnabled": true},
       "fields": [
         {"name": "email", "label": "Email", "required": true},
         {"name": "attributes", "label": "Attributes (JSON)", "type": "json", "placeholder": "{ \"FIRSTNAME\": \"{{ input.first }}\" }"},
         {"name": "list_ids", "label": "List IDs (JSON array)", "type": "json", "placeholder": "[2, 7]"}
       ]},
      {"id": "send_email", "label": "Send transactional email", "method": "POST", "path": "/smtp/email",
       "body": {"sender": {"email": "{from_email}", "name": "{from_name}"}, "to": [{"email": "{to}"}], "subject": "{subject}", "htmlContent": "{html}", "textContent": "{text}"},
       "fields": [
         {"name": "from_email", "label": "From email", "required": true},
         {"name": "from_name", "label": "From name"},
         {"name": "to", "label": "To", "required": true},
         {"name": "subject", "label": "Subject", "required": true},
         {"name": "html", "label": "HTML body", "type": "textarea"},
         {"name": "text", "label": "Text body", "type": "textarea"}
       ]}
    ]
  },
  {
    "slug": "klaviyo", "name": "Klaviyo", "category": "Marketing", "color": "#232426", "icon": "mail",
    "description": "Sync profiles and track events for Klaviyo flows",
    "docs_url": "https://developers.klaviyo.com/en/reference/api_overview",
    "credentials": [{"name": "KLAVIYO_API_KEY", "label": "Private API key", "secret": true, "help": "Klaviyo → Settings → API keys. Starts with pk_."}],
    "http": {
      "base_url": "https://a.klaviyo.com/api",
      "auth": {"type": "header", "header": "Authorization", "prefix": "Klaviyo-API-Key ", "credential": "KLAVIYO_API_KEY"},
      "headers": {"revision": "2024-10-15", "Accept": "application/vnd.api+json", "Content-Type": "application/vnd.api+json"},
      "test": {"id": "test", "label": "Accounts", "method": "GET", "path": "/accounts", "fields": []}
    },
    "actions": [
      {"id": "create_profile", "label": "Create profile", "method": "POST", "path": "/profiles",
       "body": {"data": {"type": "profile", "attributes": {"email": "{email}", "first_name": "{first_name}", "last_name": "{last_name}", "phone_number": "{phone}", "properties": "{properties}"}}},
       "fields": [
         {"name": "email", "label": "Email", "required": true},
         {"name": "first_name", "label": "First name"},
         {"name": "last_name", "label": "Last name"},
         {"name": "phone", "label": "Phone (E.164)"},
         {"name": "properties", "label": "Custom properties (JSON)", "type": "json"}
       ]},
      {"id": "track_event", "label": "Track event", "method": "POST", "path": "/events",
       "body": {"data": {"type": "event", "attributes": {"properties": "{properties}", "metric": {"data": {"type": "metric", "attributes": {"name": "{metric}"}}}, "profile": {"data": {"type": "profile", "attributes": {"email": "{email}"}}}}}},
       "fields": [
         {"name": "metric", "label": "Event name", "required": true, "placeholder": "Placed Order"},
         {"name": "email", "label": "Profile email", "required": true},
         {"name": "properties", "label": "Properties (JSON)", "type": "json"}
       ]}
    ]
  },
