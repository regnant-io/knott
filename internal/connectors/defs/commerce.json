      {"id": "list_trackings", "label": "List trackings", "method": "GET", "path": "/trackings", "query": {"tag": "{tag}"}, "items_path": "data.trackings",
       "fields": [{"name": "tag", "label": "Status tag", "type": "select", "options": ["Pending", "InfoReceived", "InTransit", "OutForDelivery", "AttemptFail", "Delivered", "Exception", "Expired"]}]}
