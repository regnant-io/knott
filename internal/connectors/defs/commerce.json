[
  {
    "slug": "bigcommerce", "name": "BigCommerce", "category": "E-commerce", "color": "#121118", "icon": "shopping-cart",
    "description": "Read orders and products, and create customers in BigCommerce",
    "docs_url": "https://developer.bigcommerce.com/docs/rest-management",
    "credentials": [
      {"name": "BIGCOMMERCE_STORE_HASH", "label": "Store hash", "placeholder": "abc123", "help": "The code in your API path: /stores/{hash}/."},
      {"name": "BIGCOMMERCE_ACCESS_TOKEN", "label": "Access token", "secret": true, "help": "Settings → API accounts → Create store-level API account."}
    ],
    "http": {
      "base_url": "https://api.bigcommerce.com/stores/{cred:BIGCOMMERCE_STORE_HASH}",
      "auth": {"type": "header", "header": "X-Auth-Token", "credential": "BIGCOMMERCE_ACCESS_TOKEN"},
      "test": {"id": "test", "label": "Store info", "method": "GET", "path": "/v2/store", "fields": []}
    },
    "actions": [
      {"id": "list_orders", "label": "List orders", "method": "GET", "path": "/v2/orders", "query": {"status_id": "{status_id}", "limit": "{limit}", "min_date_created": "{since}"},
       "fields": [
         {"name": "status_id", "label": "Status ID", "type": "number"},
         {"name": "since", "label": "Created since", "placeholder": "2026-01-01"},
         {"name": "limit", "label": "Limit", "type": "number", "default": 50}
       ]},
      {"id": "get_order", "label": "Get order", "method": "GET", "path": "/v2/orders/{order_id}",
       "fields": [{"name": "order_id", "label": "Order ID", "required": true}]},
      {"id": "list_products", "label": "List products", "method": "GET", "path": "/v3/catalog/products", "query": {"keyword": "{keyword}", "limit": "{limit}"}, "items_path": "data",
       "fields": [
         {"name": "keyword", "label": "Keyword"},
         {"name": "limit", "label": "Limit", "type": "number", "default": 50}
       ]},
      {"id": "create_customer", "label": "Create customer", "method": "POST", "path": "/v3/customers",
       "body": [{"email": "{email}", "first_name": "{first_name}", "last_name": "{last_name}", "phone": "{phone}"}],
       "fields": [
         {"name": "email", "label": "Email", "required": true},
         {"name": "first_name", "label": "First name", "required": true},
         {"name": "last_name", "label": "Last name", "required": true},
         {"name": "phone", "label": "Phone"}
       ]}
    ]
  },
  {
    "slug": "square", "name": "Square", "category": "E-commerce", "color": "#006AFF", "icon": "credit-card",
    "description": "Read payments and orders, and manage customers in Square",
    "docs_url": "https://developer.squareup.com/reference/square",
    "credentials": [{"name": "SQUARE_ACCESS_TOKEN", "label": "Access token", "secret": true, "help": "Developer dashboard → your application → Credentials."}],
    "http": {
      "base_url": "https://connect.squareup.com/v2",
      "auth": {"type": "bearer", "credential": "SQUARE_ACCESS_TOKEN"},
      "headers": {"Square-Version": "2024-10-17"},
      "test": {"id": "test", "label": "Locations", "method": "GET", "path": "/locations", "fields": []}
    },
    "actions": [
      {"id": "list_payments", "label": "List payments", "method": "GET", "path": "/payments", "query": {"begin_time": "{begin_time}", "location_id": "{location_id}"}, "items_path": "payments",
       "fields": [
         {"name": "begin_time", "label": "Since (RFC 3339)"},
         {"name": "location_id", "label": "Location ID"}
       ]},
      {"id": "search_orders", "label": "Search orders", "method": "POST", "path": "/orders/search", "items_path": "orders",
       "body": {"location_ids": ["{location_id}"], "limit": "{limit}"},
       "fields": [
         {"name": "location_id", "label": "Location ID", "required": true},
         {"name": "limit", "label": "Limit", "type": "number", "default": 50}
       ]},
      {"id": "create_customer", "label": "Create customer", "method": "POST", "path": "/customers",
       "body": {"given_name": "{given_name}", "family_name": "{family_name}", "email_address": "{email}", "phone_number": "{phone}"},
       "fields": [
         {"name": "given_name", "label": "First name"},
         {"name": "family_name", "label": "Last name"},
         {"name": "email", "label": "Email", "required": true},
         {"name": "phone", "label": "Phone"}
       ]}
    ]
  },
  {
    "slug": "gumroad", "name": "Gumroad", "category": "E-commerce", "color": "#FF90E8", "icon": "shopping-bag",
