       "fields": [
         {"name": "store_id", "label": "Store ID"},
         {"name": "email", "label": "Customer email"}
       ]},
      {"id": "list_subscriptions", "label": "List subscriptions", "method": "GET", "path": "/subscriptions", "query": {"filter[status]": "{status}"}, "items_path": "data",
       "fields": [{"name": "status", "label": "Status", "type": "select", "options": ["on_trial", "active", "paused", "past_due", "unpaid", "cancelled", "expired"]}]}
    ]
