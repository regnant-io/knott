         {"name": "name", "label": "Name"}
       ]},
      {"id": "list_customers", "label": "List customers", "method": "GET", "path": "/customers", "query": {"search": "{search}"}, "items_path": "data",
       "fields": [{"name": "search", "label": "Search"}]}
    ]
