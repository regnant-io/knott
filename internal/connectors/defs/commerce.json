      "auth": {"type": "query", "param": "access_token", "credential": "GUMROAD_ACCESS_TOKEN"},
      "test": {"id": "test", "label": "User", "method": "GET", "path": "/user", "fields": []}
    },
    "actions": [
      {"id": "list_products", "label": "List products", "method": "GET", "path": "/products", "items_path": "products", "fields": []},
      {"id": "list_sales", "label": "List sales", "method": "GET", "path": "/sales", "query": {"after": "{after}", "product_id": "{product_id}"}, "items_path": "sales",
       "fields": [
         {"name": "after", "label": "After (YYYY-MM-DD)"},
         {"name": "product_id", "label": "Product ID"}
       ]}
    ]
  },
  {
    "slug": "lemonsqueezy", "name": "Lemon Squeezy", "category": "E-commerce", "color": "#FFC233", "icon": "shopping-bag",
