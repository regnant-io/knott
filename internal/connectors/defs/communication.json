    "actions": [
      {"id": "send_message", "label": "Send message", "method": "POST", "path": "/messages",
       "body": {"roomId": "{room_id}", "toPersonEmail": "{to_email}", "markdown": "{markdown}"},
       "fields": [
         {"name": "room_id", "label": "Space (room) ID"},
         {"name": "to_email", "label": "Or: person email"},
         {"name": "markdown", "label": "Message (Markdown)", "type": "textarea", "required": true}
       ]}
    ]
  },
  {
    "slug": "zulip", "name": "Zulip", "category": "Communication", "color": "#6492FE", "icon": "message-square",
    "description": "Post to Zulip streams and topics",
    "docs_url": "https://zulip.com/api/send-message",
    "credentials": [
