      {"name": "ZULIP_API_KEY", "label": "Bot API key", "secret": true}
    ],
    "http": {
      "base_url": "{cred:ZULIP_SITE}/api/v1",
      "auth": {"type": "basic", "credential": "ZULIP_EMAIL", "password": "ZULIP_API_KEY"},
      "test": {"id": "test", "label": "Own user", "method": "GET", "path": "/users/me", "fields": []}
    },
    "actions": [
      {"id": "send_stream_message", "label": "Send stream message", "method": "POST", "path": "/messages", "body_type": "form",
       "body": {"type": "stream", "to": "{stream}", "topic": "{topic}", "content": "{content}"},
       "fields": [
         {"name": "stream", "label": "Stream", "required": true},
         {"name": "topic", "label": "Topic", "required": true},
         {"name": "content", "label": "Message", "type": "textarea", "required": true}
       ]}
    ]
  },
  {
    "slug": "rocketchat", "name": "Rocket.Chat", "category": "Communication", "color": "#F5455C", "icon": "message-square",
    "description": "Post messages to a self-hosted Rocket.Chat",
    "docs_url": "https://developer.rocket.chat/apidocs/post-message",
    "credentials": [
      {"name": "ROCKETCHAT_URL", "label": "Server URL", "placeholder": "https://chat.acme.com"},
      {"name": "ROCKETCHAT_USER_ID", "label": "User ID"},
      {"name": "ROCKETCHAT_TOKEN", "label": "Personal access token", "secret": true}
    ],
    "http": {
      "base_url": "{cred:ROCKETCHAT_URL}/api/v1",
      "auth": {"type": "header", "header": "X-Auth-Token", "credential": "ROCKETCHAT_TOKEN"},
      "headers": {"X-User-Id": "{cred:ROCKETCHAT_USER_ID}"},
      "test": {"id": "test", "label": "Me", "method": "GET", "path": "/me", "fields": []}
    },
    "actions": [
      {"id": "post_message", "label": "Post message", "method": "POST", "path": "/chat.postMessage",
