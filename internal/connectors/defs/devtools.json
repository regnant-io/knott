[
  {
    "slug": "bitbucket", "name": "Bitbucket", "category": "Developer Tools", "color": "#0052CC", "icon": "git-branch",
    "description": "Create issues, list pull requests and start pipelines in Bitbucket Cloud",
    "docs_url": "https://developer.atlassian.com/cloud/bitbucket/rest/",
    "credentials": [
      {"name": "BITBUCKET_USERNAME", "label": "Username"},
      {"name": "BITBUCKET_APP_PASSWORD", "label": "App password / API token", "secret": true}
    ],
    "http": {
      "base_url": "https://api.bitbucket.org/2.0",
      "auth": {"type": "basic", "credential": "BITBUCKET_USERNAME", "password": "BITBUCKET_APP_PASSWORD"},
      "test": {"id": "test", "label": "Current user", "method": "GET", "path": "/user", "fields": []}
    },
    "actions": [
      {"id": "list_pull_requests", "label": "List pull requests", "method": "GET", "path": "/repositories/{workspace}/{repo_slug}/pullrequests", "query": {"state": "{state}"}, "items_path": "values",
       "fields": [
         {"name": "workspace", "label": "Workspace", "required": true},
         {"name": "repo_slug", "label": "Repository", "required": true},
         {"name": "state", "label": "State", "type": "select", "options": ["OPEN", "MERGED", "DECLINED", "SUPERSEDED"]}
       ]},
      {"id": "create_issue", "label": "Create issue", "method": "POST", "path": "/repositories/{workspace}/{repo_slug}/issues",
       "body": {"title": "{title}", "content": {"raw": "{content}"}},
       "fields": [
         {"name": "workspace", "label": "Workspace", "required": true},
         {"name": "repo_slug", "label": "Repository", "required": true},
         {"name": "title", "label": "Title", "required": true},
         {"name": "content", "label": "Description", "type": "textarea"}
       ]},
      {"id": "trigger_pipeline", "label": "Run pipeline", "method": "POST", "path": "/repositories/{workspace}/{repo_slug}/pipelines/",
       "body": {"target": {"type": "pipeline_ref_target", "ref_type": "branch", "ref_name": "{branch}"}},
       "fields": [
         {"name": "workspace", "label": "Workspace", "required": true},
         {"name": "repo_slug", "label": "Repository", "required": true},
         {"name": "branch", "label": "Branch", "required": true, "default": "main"}
       ]}
    ]
  },
