# ─────────────────────────────────────────────────────────────────────────────
# KNOTT — configuration
#
# Everything here is optional. KNOTT starts with no configuration at all: it
# binds to loopback, generates its own encryption key, and falls back to
# deterministic rule-based AI decisions. That is a working laptop install.
#
# What follows is what to set before anyone else can reach it. Copy this file to
# .env, or set these as environment variables — a container or systemd unit
# should do the latter.
# ─────────────────────────────────────────────────────────────────────────────

# ── Before you expose KNOTT ──────────────────────────────────────────────────

# API keys, as key:role pairs. Roles:
#   admin     everything, including credentials and AI provider settings
#   operator  create, run and cancel workflows; read everything
#   viewer    read only
# Generate keys with: openssl rand -hex 32
# Without this, the API is open to anyone who can reach the port.
API_KEYS=

# Encrypts stored connector credentials (AES-256-GCM at rest).
# The all-in-one binary generates one on first run and saves it to secret.key in
# the state directory. Set it explicitly for a container or a rebuilt volume,
# where that file would not survive.
#   openssl rand -hex 32
KNOTT_SECRET_KEY=

# Requires inbound webhooks to carry an HMAC-SHA256 of the raw body in
# X-KNOTT-Signature. Without it, anyone who can reach the port can start a run.
WEBHOOK_SECRET=

# Browser origins allowed to call the API. Permissive by default, which suits
# local development. Set this to your console's origin in production.
#   CORS_ORIGINS=https://knott.example.com
CORS_ORIGINS=

# ── Where it listens ─────────────────────────────────────────────────────────

# Defaults to 127.0.0.1:8002. Set the host to 0.0.0.0 to accept connections from
# the network — do that only with API_KEYS set, and TLS in front.
PORT=8002
KNOTT_BIND_HOST=127.0.0.1

# Where KNOTT keeps its databases and secret key. Defaults to the per-OS
# application data directory (knott home prints it).
KNOTT_HOME=

# ── AI provider ──────────────────────────────────────────────────────────────
#
# All three of these are also settable in the console under Settings, which
# takes effect immediately and survives a restart. These are just the initial
# defaults. With neither provider configured, KNOTT uses its built-in
# rule-based decisions — real, deterministic and offline, if less nuanced.

# Anthropic Claude.
ANTHROPIC_API_KEY=

# Ollama, for decisions that never leave your network.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:latest

# auto | anthropic | ollama | simulation
AI_PROVIDER=auto

# ── Operations ───────────────────────────────────────────────────────────────

# Delete finished runs older than this many days. 0 keeps everything, which
# grows without bound — set it to whatever your retention policy allows.
RUN_RETENTION_DAYS=90

# Bearer token required on /metrics. Leave empty on a private network.
METRICS_TOKEN=

# How long a run lease lives before another replica may reclaim it. Only
# relevant when several engine replicas share a database.
RUN_LEASE_TTL_SECONDS=60

# ── Distributed deployment only ──────────────────────────────────────────────
#
# Ignore all of this for the single binary, which runs every service in one
# process on loopback ports it chooses itself. These matter when you run
# knott-registry, knott-engine, knott-tasks and knott-agents separately.

# REGISTRY_URL=http://registry:8001
# AI_DECISION_URL=http://ai:8003
# HUMAN_TASK_URL=http://tasks:8004
# AGENT_URL=http://agents:8005
# EXECUTION_ENGINE_URL=http://engine:8002
# ENGINE_DB=/var/lib/knott/runs.db
# REGISTRY_DB=/var/lib/knott/workflows.db
# TASK_DB=/var/lib/knott/tasks.db
# AGENT_DB=/var/lib/knott/agents.db
