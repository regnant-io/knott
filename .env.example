# ─────────────────────────────────────────────────────────────────────────────
# KW Sagittarii — Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────
# AI Provider Configuration
# ANTHROPIC_API_KEY: Claude API for high-quality AI decisions (recommended)
# OLLAMA_BASE_URL: Local Ollama instance for offline/private deployments
# If both are set, Anthropic is used by default. Set AI_PROVIDER=ollama to prefer Ollama.
ANTHROPIC_API_KEY=sk-ant-...
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest
AI_PROVIDER=auto

# ── Security ──────────────────────────────────────────────────────────────────
# API_TOKEN: when set, the engine (single exposed port) requires this token on all
#   API calls. The UI prompts for it once and stores it in the browser. Leave empty
#   for local/dev only — NEVER expose KNOTT publicly without it.
# API_KEYS: optional role-based multi-key auth (supersedes API_TOKEN when set).
#   Format: "key1:admin,key2:operator,key3:viewer". Roles:
#     admin    — full access (settings + credentials + writes + reads)
#     operator — create/run/cancel workflows + reads (no credential/settings writes)
#     viewer   — read-only (GET)
#   API_TOKEN, if also set, is treated as an additional admin key.
# WEBHOOK_SECRET: when set, inbound webhooks (/api/v1/hooks/<id>) must be signed with
#   HMAC-SHA256 of the raw body in the X-KNOTT-Signature header (hex, "sha256=" ok).
# KNOTT_SECRET_KEY: master key used to encrypt connector credentials stored via the
#   UI (AES-256-GCM at rest). Set a strong random value in production.
# METRICS_TOKEN: optional bearer token to protect the Prometheus /metrics endpoint.
# BIND_HOST: bind address for the INTERNAL services (registry/AI/task/agent). Set to
#   127.0.0.1 on a single host so only the engine (behind your proxy) can reach them.
#   Leave empty for Docker (the container network already isolates them).
# ENGINE_BIND_HOST: bind address for the engine itself. Leave empty (all interfaces)
#   when a reverse proxy on another host fronts it; set 127.0.0.1 if proxy is co-located.
API_TOKEN=
API_KEYS=
WEBHOOK_SECRET=
KNOTT_SECRET_KEY=
METRICS_TOKEN=
BIND_HOST=
ENGINE_BIND_HOST=

# CORS_ORIGINS: comma-separated allowed origins for the API (empty = allow all;
#   set to your UI origin(s) in production, e.g. https://knott.example.com).
CORS_ORIGINS=

# ── Operations ────────────────────────────────────────────────────────────────
# RUN_RETENTION_DAYS: terminal runs (and their events) older than this are pruned
#   daily so the SQLite DB doesn't grow forever. 0 disables pruning. Default 90.
# TASK_NOTIFY_WEBHOOK: optional URL (e.g. a Slack/Teams/Mattermost incoming
#   webhook) that receives a JSON message when a human task is created or
#   becomes overdue — so reviewers don't have to watch the inbox.
RUN_RETENTION_DAYS=90
TASK_NOTIFY_WEBHOOK=

# ── Horizontal scaling (run leasing) ──────────────────────────────────────────
# Multiple engine replicas can share one database; each run is leased to exactly
# one replica and a dead replica's runs are reclaimed automatically.
# ENGINE_INSTANCE_ID: unique id per replica (defaults to hostname-pid).
# RUN_LEASE_TTL_SECONDS: lease validity before a stalled run can be reclaimed (default 60).
ENGINE_INSTANCE_ID=
RUN_LEASE_TTL_SECONDS=60

# ── Service Ports ─────────────────────────────────────────────────────────────
REGISTRY_PORT=8001
ENGINE_PORT=8002
AI_PORT=8003
TASK_PORT=8004
AGENT_PORT=8005

# ── Service Discovery ─────────────────────────────────────────────────────────
REGISTRY_URL=http://localhost:8001
AI_DECISION_URL=http://localhost:8003
HUMAN_TASK_URL=http://localhost:8004
AGENT_URL=http://localhost:8005
EXECUTION_ENGINE_URL=http://localhost:8002

# ── Database paths (SQLite, created automatically) ────────────────────────────
REGISTRY_DB=./data/workflows.db
ENGINE_DB=./data/runs.db
TASK_DB=./data/tasks.db
AGENT_DB=./data/agents.db

# ── Frontend ──────────────────────────────────────────────────────────────────
# In production: execution engine serves the built React app
FRONTEND_PATH=./apps/designer/dist

# ── Connector Credentials (optional) ──────────────────────────────────────────
# Tool Call nodes read these at runtime; they are never stored in a workflow.
# Slack: provide an incoming webhook URL (preferred) or a bot token.
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
# SendGrid transactional email
SENDGRID_API_KEY=
SENDGRID_FROM=
# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Telegram / Discord
TELEGRAM_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
# GitHub / Jira
GITHUB_TOKEN=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_BASE_URL=
# Airtable / Notion / HubSpot
AIRTABLE_TOKEN=
NOTION_TOKEN=
HUBSPOT_TOKEN=
# Google Sheets — OAuth refresh flow (auto-refreshes access tokens):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
#   or a short-lived access token for quick tests:
GOOGLE_ACCESS_TOKEN=
# Microsoft Teams (incoming webhook) / Stripe
TEAMS_WEBHOOK_URL=
STRIPE_SECRET_KEY=
# Database (SQL) connection string, e.g. ./data/app.db?_pragma=busy_timeout(5000)
DATABASE_DSN=
# ── More connectors (optional) ────────────────────────────────────────────────
LINEAR_API_KEY=
TRELLO_KEY=
TRELLO_TOKEN=
ASANA_TOKEN=
CLICKUP_TOKEN=
PAGERDUTY_ROUTING_KEY=
MATTERMOST_WEBHOOK_URL=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
ZENDESK_BASE_URL=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_STORE_URL=
MAILCHIMP_API_KEY=
OPENAI_API_KEY=
PUSHOVER_TOKEN=
PUSHOVER_USER=
GITLAB_TOKEN=
MONDAY_TOKEN=
FRESHDESK_API_KEY=
FRESHDESK_BASE_URL=
INTERCOM_TOKEN=
MS_GRAPH_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
CODA_TOKEN=
CLOSE_API_KEY=
CALENDLY_TOKEN=
SERVICENOW_USER=
SERVICENOW_PASSWORD=
SERVICENOW_BASE_URL=
# Agent Call auth (per registered agent id, non-alphanumerics -> _, uppercased):
#   AGENT_<ID>_TOKEN     for bearer agents
#   AGENT_<ID>_API_KEY   for api-key agents
