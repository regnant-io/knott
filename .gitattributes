# Normalise line endings so a Windows checkout does not produce a diff of the
# whole tree, and gofmt stays meaningful in review.
* text=auto eol=lf

*.bat  text eol=crlf
*.ps1  text eol=crlf

*.png  binary
*.ico  binary
*.icns binary
*.pdf  binary
*.zip  binary
*.gz   binary

# Keep generated and vendored files out of language statistics and diffs.
apps/designer/package-lock.json linguist-generated=true
apps/designer/src/components/Brand.jsx linguist-generated=true
brand/icons/* linguist-generated=true
